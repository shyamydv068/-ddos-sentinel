APP_NAME=DDoS-Sentinel
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/ddos_sentinel
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NETWORK_TRAFFIC_TOPIC=network-traffic
KAFKA_DDOS_TOPIC=ddos-detection
KAFKA_ALERTS_TOPIC=security-alerts
KAFKA_MITIGATION_TOPIC=mitigation-events
KAFKA_SYSTEM_TOPIC=system-events
SPARK_MASTER=local[*]
MODEL_PATH=ml/models
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://frontend:5173
DRY_RUN_MODE=true

# Replace with your local values for production.
# Do not commit real secrets or credentials.
